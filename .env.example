# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Database Configuration
DATABASE_URL=sqlite:///penny_bot.db

# Retail Websites (Add your target sites)
TARGET_WEBSITES=amazon.com,walmart.com,ebay.com,bestbuy.com

# Bot Settings
MAX_PRICE_THRESHOLD=1.00
SEARCH_INTERVAL_MINUTES=60
DEBUG_MODE=False

# Notification Settings
NOTIFY_EMAIL=your_email@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
